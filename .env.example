# Flask security
# REQUIRED in production. The app now REFUSES TO START if this is missing,
# still a placeholder, or shorter than 32 characters - a guessable secret
# means anyone can forge a session cookie and become Admin.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Local convenience: `python run.py` automatically creates a git-ignored
# `.env` and generates this value when it is missing. Never commit `.env`.
SECRET_KEY=
FLASK_ENV=production

# Set to 1/0 to force the session cookie Secure flag. Left blank it now
# defaults to ON in production instead of OFF.
SESSION_COOKIE_SECURE=

# Phase 20D - login throttling. Failed logins are counted per email AND per
# source IP inside a rolling window; both must be exceeded independently.
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Database
# Local SQLite:
DATABASE_URL=sqlite:///solar_documents.db
# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/solar_doc_system

# Upload folder
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_MB=20

# Mail settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Phase 15F AI Assistant
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Phase 16D - WhatsApp Cloud API / Meta Business Platform
# Keep the real token ONLY in Render Environment Variables. Do not commit it to GitHub.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1091324590741999
WHATSAPP_BUSINESS_ACCOUNT_ID=4334785340171192
WHATSAPP_VERIFY_TOKEN=cmse_whatsapp_verify_2026
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=cmse_test
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_QUOTATION_TEMPLATE_NAME=quotation_ready_v2
WHATSAPP_QUOTATION_TEMPLATE_LANGUAGE=en
PUBLIC_BASE_URL=https://cmse2.onrender.com

# Phase 20D - backups. Render's local disk is EPHEMERAL: anything written
# here is deleted on the next deploy. Point this at a mounted persistent
# disk, or move backups to object storage. A backup on an ephemeral disk
# is not a backup.
CMSE_BACKUP_DIR=
